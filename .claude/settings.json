{
  "permissions": {
    "allow": [
      "Edit(*)",
      "Write(*)",
      "WebFetch(*)",
      "Bash(git *)",
      "Bash(gh *)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(sudo *)",
      "Bash(docker *)",
      "Bash(kubectl *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(pkill *)",
      "Bash(chmod *)",
      "Bash(chown *)"
    ]
  },
  "outputStyle": "intuitive",
  "includeCoAuthoredBy": false,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  }
}
