{
  "name": "engage",
  "version": 2,
  "about": "Machine-readable map of Engage for status displays. The stage skills hold the instructions. Keep stage ids, step ids and step names in sync with their headings.",
  "stages": [
    {
      "id": "setup", "name": "Setup", "skill": "engage-setup", "phase": "workspace", "status": "ready",
      "runs": "once per workspace",
      "steps": [
        {"id": "1", "name": "Check the marker"},
        {"id": "2", "name": "Preconditions"},
        {"id": "3", "name": "Marketplace and LSP plugins"},
        {"id": "4", "name": "Language servers"},
        {"id": "5", "name": "MCP tools"},
        {"id": "6", "name": "Reload and probe the language servers"},
        {"id": "7", "name": "Write the marker"}
      ]
    },
    {
      "id": "planalysis", "name": "Planalysis", "skill": "engage-planalysis", "phase": "interactive", "status": "ready",
      "runs": "per ticket, with the user", "ends_with": "Engage.",
      "steps": [
        {"id": "0", "name": "Open the ticket"},
        {"id": "1", "name": "Collect sources"},
        {"id": "2", "name": "Classify and pick a track"},
        {"id": "3", "name": "Place the ticket"},
        {"id": "4", "name": "Restate the ask"},
        {"id": "5", "name": "Interview"},
        {"id": "6", "name": "Technical analysis"},
        {"id": "7", "name": "Verification recipe"},
        {"id": "8", "name": "Size and plan the build"},
        {"id": "9", "name": "Make the factory ready"},
        {"id": "10", "name": "Report and wait for Engage."}
      ]
    },
    {
      "id": "implementation", "name": "Implementation", "skill": "engage-implement", "phase": "factory", "loop": "build", "status": "draft",
      "runs": "per round",
      "steps": [
        {"id": "build", "name": "Build the plan"},
        {"id": "design-pass", "name": "Design pass"},
        {"id": "fix", "name": "Fix findings"}
      ]
    },
    {
      "id": "verify", "name": "Verify", "skill": "engage-verify", "phase": "factory", "loop": "build", "status": "draft",
      "runs": "per round",
      "steps": [
        {"id": "seed", "name": "Seed the data"},
        {"id": "run", "name": "Run the verifier"},
        {"id": "evidence", "name": "Check the evidence"}
      ]
    },
    {
      "id": "review", "name": "Review", "skill": "engage-review", "phase": "factory", "loop": "build", "status": "draft",
      "runs": "per round",
      "steps": [
        {"id": "style", "name": "Style pass"},
        {"id": "code", "name": "Code review"},
        {"id": "spec", "name": "Spec review"},
        {"id": "triage", "name": "Triage"},
        {"id": "tree", "name": "Record the tree id"}
      ]
    },
    {
      "id": "ship", "name": "Ship", "skill": "engage-ship", "phase": "factory", "status": "ready",
      "runs": "after the loop converges, and after each feedback round",
      "steps": [
        {"id": "1", "name": "Check the ticket"},
        {"id": "2", "name": "Plan the commits"},
        {"id": "3", "name": "Commit and push"},
        {"id": "4", "name": "Write the PR bodies"},
        {"id": "5", "name": "Open the draft PRs"},
        {"id": "6", "name": "Read back each PR"},
        {"id": "7", "name": "Record what shipped"},
        {"id": "8", "name": "Report"}
      ]
    },
    {
      "id": "qa", "name": "QA", "skill": "engage-qa", "phase": "after-ship", "status": "draft",
      "runs": "after Ship, until QA and acceptance pass and the change is live",
      "steps": [
        {"id": "1", "name": "Hold the test environment"},
        {"id": "2", "name": "Write the hand-off"},
        {"id": "3", "name": "Answer testers"},
        {"id": "4", "name": "Route tester reports"},
        {"id": "5", "name": "Check the deploy"}
      ]
    },
    {
      "id": "feedback", "name": "Feedback", "skill": "engage-feedback", "phase": "after-ship", "loop": "feedback", "status": "ready",
      "runs": "per round of PR review, tester reports or ticket changes",
      "steps": [
        {"id": "1", "name": "Collect"},
        {"id": "2", "name": "Keep branches current"},
        {"id": "3", "name": "Triage"},
        {"id": "4", "name": "Run the loop on the feedback only"},
        {"id": "5", "name": "Ship again"},
        {"id": "6", "name": "Report"}
      ]
    },
    {
      "id": "reflect", "name": "Reflect", "skill": "engage-reflect", "phase": "retro", "status": "ready",
      "runs": "per ticket, when the user asks",
      "steps": [
        {"id": "1", "name": "Build the corpus"},
        {"id": "2", "name": "Map sessions to stages"},
        {"id": "3", "name": "Read the corpus"},
        {"id": "4", "name": "Look for evidence"},
        {"id": "5", "name": "Write reflect.md"},
        {"id": "6", "name": "Report"}
      ]
    }
  ],
  "loops": [
    {"id": "build", "name": "Build loop", "stages": ["implementation", "verify", "review"], "counter": "round", "cap": 3},
    {"id": "feedback", "name": "Feedback round", "stages": ["feedback", "implementation", "verify", "review", "ship"], "counter": "feedback_round"}
  ],
  "tracks": ["quick", "standard", "project", "answer"],
  "stage_states": ["pending", "in_progress", "complete", "skipped"],
  "stage_status": ["in_progress", "waiting", "awaiting_engage", "complete"],
  "waiting_on": ["nothing", "user", "product", "testers", "worker:<name>"],
  "worker_status": ["starting", "working", "idle", "blocked", "done", "closed"],
  "stops": [
    {"id": 1, "name": "A permission only the user can give"},
    {"id": 2, "name": "A change that reverses a decision or shipped behavior"},
    {"id": 3, "name": "A behavior decision the plan does not cover"},
    {"id": 4, "name": "No convergence after three rounds"},
    {"id": 5, "name": "An action outside the workspace beyond pushes and draft PRs"}
  ],
  "files": {
    "framework": "~/.claude/skills/engage/framework.json",
    "setup_marker": "~/.claude/tickets/dev-setup.md",
    "tickets": "~/.claude/tickets/<KEY>/",
    "state": "~/.claude/tickets/<KEY>/state.md",
    "plan": "~/.claude/tickets/<KEY>/plan.md",
    "findings": "~/.claude/tickets/<KEY>/findings.md"
  }
}
